# =====================================================================
# .env.example - ALVA Backend
# =====================================================================
# Copie este arquivo para ".env" (ou configure estas variáveis direto
# no seu sistema/CI/Docker) e preencha com os valores reais.
# NUNCA commitar o arquivo ".env" com valores reais - ele deve estar
# no .gitignore.
# =====================================================================

# Perfil ativo: dev | prod | test
SPRING_PROFILES_ACTIVE=dev

# --------------------- Banco de Dados ---------------------
DB_URL=jdbc:postgresql://localhost:5432/alva_db
DB_USER=alva_user
DB_PASSWORD=troque_esta_senha
DB_DRIVER=org.postgresql.Driver

# --------------------- JPA / Hibernate ---------------------
# update (dev) | validate (prod, recomendado) | none
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true

# --------------------- Servidor ---------------------
SERVER_PORT=8080

# --------------------- Segurança / JWT ---------------------
# Gere uma string aleatória forte (ex: openssl rand -base64 48)
JWT_SECRET=troque_este_valor_por_um_segredo_forte_e_unico
JWT_EXPIRATION_MS=86400000

# --------------------- CORS ---------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173
