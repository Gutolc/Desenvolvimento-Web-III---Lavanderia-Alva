# ============================================================
# Lavanderia Alva — template de variáveis de ambiente
# Copie para .env e preencha os valores reais.
# ============================================================

# ---- MySQL ----
DB_URL=jdbc:mysql://localhost:3306/alva
DB_USERNAME=root
DB_PASSWORD=

# ---- JWT ----
# Gere com: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# ---- Admin seed ----
ADMIN_EMAIL=
ADMIN_SENHA=
